# Worker が Job を取り出す順番。fifo = 先入れ先出し(Queue)、lifo = 後入れ先出し(Stack)。
# 通常は fifo(先に登録した人に先にメールが届く)。lifo は Stack の挙動を体感する実験用
QUEUE_ORDER="fifo"
