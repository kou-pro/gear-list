// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique
  // 平文は絶対に保存しない。カラム名で「ハッシュしか入らない」ことを明示する
  passwordHash       String
  // メールアドレス確認が完了した日時。null = 未確認。
  // Boolean ではなく DateTime? にすることで「確認済みか」と「いつ確認したか」を1カラムで表す
  emailVerifiedAt    DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  gearLists          GearList[]
  sessions           Session[]
  verificationTokens VerificationToken[]
}

// メールアドレス確認用のトークン。設計は Session と同じパターン:
// 推測不能な乱数を DB に保存し、リンクを開けた(=トークンを提示できた)人を
// メールの持ち主とみなす。トークンはメールを受信できた人しか知りえない
model VerificationToken {
  id        String   @id // 乱数32バイトをアプリ側で生成(@default を付けない)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime // 24時間で失効
  createdAt DateTime @default(now())

  @@index([userId])
}

// 「ログイン中である」という事実を保持するテーブル。
// Cookie には id(乱数)だけを載せ、どのユーザーかの対応はこのテーブルが持つ。
model Session {
  // @default を付けないのは、推測不能な乱数をアプリ側で生成して入れるため
  // (連番だと他人のセッションIDを推測できてしまう)
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Cookie の有効期限はクライアント側にあり改ざんできるため、サーバー側でも期限を持つ
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model GearList {
  id          Int        @id @default(autoincrement())
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  title       String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       GearItem[]

  // 認証後は where: { userId } で毎回絞り込むため、外部キーにインデックスを張る
  @@index([userId])
}

model GearItem {
  id         Int      @id @default(autoincrement())
  name       String
  quantity   Int      @default(1)
  checked    Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  gearList   GearList @relation(fields: [gearListId], references: [id], onDelete: Cascade)
  gearListId Int
}
