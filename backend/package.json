{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:db:up": "docker compose -f ../docker-compose.yml up -d --wait db-test",
    "test:int": "npm run test:db:up && dotenv -e .env.test -- prisma migrate deploy && dotenv -e .env.test -- vitest -c vitest.config.integration.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@hono/zod-validator": "^0.9.0",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "hono": "^4.12.33",
    "nodemailer": "^9.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
